# ══════════════════════════════════════════════
# Unity .gitignore
# Módulo IV: Programación de Videojuegos — UNAM
# ══════════════════════════════════════════════

# ── Unity generated ──
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# ── Memory/Crash captures ──
sysinfo.txt
crashlytics-build.properties

# ── Builds ──
*.apk
*.aab
*.unitypackage
*.app

# ── IDE ──
# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.iml

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# ── OS files ──
.DS_Store
Thumbs.db
desktop.ini

# ── Asset meta files (keep them!) ──
# *.meta  ← NO descomentar. Los .meta son necesarios.

# ── Packages lock ──
# Uncomment if you want to track package lock
# !/Packages/packages-lock.json

# ── TextMeshPro ──
/Assets/TextMesh Pro/
